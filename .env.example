# Copiez ce fichier en .env et complétez. Seule DATABASE_URL est obligatoire.

# Base PostgreSQL (>= 13). Le schéma est créé au premier démarrage.
DATABASE_URL=postgres://localhost/freefact
PORT=3000
# Adresse publique : sert aux liens envoyés par email et WhatsApp.
PUBLIC_URL=https://app.freefact.ci
# production : cookies Secure, mode simulation FNE refusé.
NODE_ENV=production

# Emails (vérification, mot de passe oublié, factures, récapitulatif quotidien).
# Sans SMTP_URL, les emails sont gardés dans la table outbox et écrits dans les journaux.
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.ci:465
MAIL_FROM=FreeFact <no-reply@freefact.ci>

# Connexion Google : identifiants OAuth (URI de redirection : PUBLIC_URL/auth/google/retour).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Intelligence artificielle (facture express, relances, assistant, prévisions).
ANTHROPIC_API_KEY=
FREEFACT_AI_MODEL=claude-opus-5-5

# Certification FNE : manuel (défaut) | api (après agrément DGI) | simulation (développement seulement).
FNE_MODE=manuel
FNE_API_URL=
FNE_API_TOKEN=

# Mettre à 1 pour couper le récapitulatif quotidien par email.
DISABLE_JOBS=0
